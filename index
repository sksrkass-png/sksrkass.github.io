${camera[1]}처럼 촬영하고, 전문적인 조명, 현실적인 스케일, 정제된 구도, 강한 공간감을 반영합니다.

이미지 비율:
${ratio[1]}.

피해야 할 요소:
${negative[1]}`;

    current.push({
      Date: today(), Name: title, ArtistName: artistName, ArtworkType: artworkType, Sensitivity: sensitivity,
      SourceArtworkDescription_EN: source[0], SourceArtworkDescription_KO: source[1],
      MustPreserve_EN: preserve[0], MustPreserve_KO: preserve[1],
      Expansion_EN: expansion[0], Expansion_KO: expansion[1],
      Material_EN: material[0], Material_KO: material[1],
      Space_EN: space[0], Space_KO: space[1],
      Scene_EN: scene[0], Scene_KO: scene[1],
      Realism_EN: realism[0], Realism_KO: realism[1],
      Camera_EN: camera[0], Camera_KO: camera[1],
      Ratio: ratio[0], Ratio_KO: ratio[1],
      EnglishPrompt: englishPrompt, KoreanPrompt: koreanPrompt,
      EnglishNegativePrompt: negative[0], KoreanNegativePrompt: negative[1],
      Status: "Generated", Rating: ""
    });
  }

  archive.unshift({ id: Date.now(), date: today(), artist: artistName, items: current });
  archive = archive.slice(0, 80);
  localStorage.setItem("artistPromptArchiveV3", JSON.stringify(archive));
  render();
  renderHistory();
  toast(`${count}개 프롬프트 생성 + Saved History 아카이브 완료`);
}

function render() {
  $("empty").style.display = current.length ? "none" : "block";
  $("outputs").innerHTML = current.map((p, i) => `<article class="card prompt-card">
    <h3>${esc(p.Name)}</h3>
    <div class="meta">
      <span class="tag">A: ${esc(p.ArtworkType)}</span>
      <span class="tag">A: ${esc(p.Sensitivity)}</span>
      <span class="tag">B: ${esc(p.Expansion_KO)}</span>
      <span class="tag">B: ${esc(p.Material_KO)}</span>
      <span class="tag">B: ${esc(p.Space_KO)}</span>
      <span class="tag">B: ${esc(p.Scene_KO)}</span>
      <span class="tag">Ratio: ${esc(p.Ratio_KO)}</span>
    </div>
    <div class="prompt-columns">
      <div><div class="section-title">English Prompt</div><pre>${esc(p.EnglishPrompt)}</pre></div>
      <div><div class="section-title">한글 프롬프트</div><pre class="korean-pre">${esc(p.KoreanPrompt)}</pre></div>
    </div>
    <div class="actions copy-actions">
      <button class="secondary" onclick="copyOne(${i}, 'en')">영문 복사</button>
      <button class="secondary" onclick="copyOne(${i}, 'ko')">한글 복사</button>
    </div>
  </article>`).join("");
}

function renderHistory() {
  $("history").innerHTML = archive.map((h, idx) => `<button onclick="loadHistory(${idx})">${esc(h.date)} · ${esc(h.artist)} · ${h.items.length} prompts</button>`).join("") || "<p class='muted'>저장 기록 없음</p>";
}

function loadHistory(idx) {
  current = archive[idx].items;
  render();
  toast("Saved History에서 기록을 불러왔습니다");
}

async function copyOne(i, mode) {
  const p = current[i];
  const text = mode === "en" ? p.EnglishPrompt : p.KoreanPrompt;
  await navigator.clipboard.writeText(text);
  toast("프롬프트 복사 완료");
}

function csvCell(v) { return `"${String(v ?? "").replaceAll('"', '""')}"`; }

function downloadCSV() {
  if (!current.length) return toast("CSV로 다운로드할 프롬프트가 없습니다");
  const keys = Object.keys(current[0]);
  const csv = "\uFEFF" + keys.join(",") + "\n" + current.map(row => keys.map(key => csvCell(row[key])).join(",")).join("\n");
  download(csv, `artist_extension_prompts_${today()}.csv`, "text/csv;charset=utf-8");
}

function download(content, name, type) {
  const blob = new Blob([content], { type });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = name;
  a.click();
  URL.revokeObjectURL(url);
  toast("CSV 파일 다운로드 완료");
}

function clearCurrent() {
  current = [];
  render();
  toast("우측 생성 프롬프트 초기화 완료");
}

function toast(msg) {
  const t = $("toast");
  t.textContent = msg;
  t.style.display = "block";
  clearTimeout(window.__toastTimer);
  window.__toastTimer = setTimeout(() => t.style.display = "none", 2200);
}

fillBasic("artworkType", LIB.artworkTypes);
fillBasic("sensitivity", LIB.sensitivities);
[
  ["sourceMode", "source", true], ["preserveMode", "preserve", true], ["expansionMode", "expansion"],
  ["materialMode", "material"], ["spaceMode", "space"], ["sceneMode", "scene"],
  ["realismMode", "realism"], ["cameraMode", "camera"], ["negativeMode", "negative"],
  ["ratioMode", "ratio"]
].forEach(([id, key, allowNone]) => fillPair(id, LIB[key], "Auto Random / 자동 랜덤", !!allowNone));
renderHistory();
